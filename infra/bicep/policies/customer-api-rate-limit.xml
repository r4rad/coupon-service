<!--
  API-level rate limit for customer-facing coupon and order APIs (AC-9.7).
  Consumption tier accepts rate-limit at API scope; rate-limit-by-key is unavailable.
-->
<policies>
  <inbound>
    <base />
    <rate-limit calls="60" renewal-period="60" remaining-calls-variable-name="remainingCalls" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
