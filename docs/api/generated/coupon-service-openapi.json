    "/v1/policy-engine/manifest": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Get the engine manifest",
        "description": "Returns every registered fact with its type and cost, every condition operator, every effect operator, and the configured parse limits. Generated from the live registry so it cannot drift.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/EngineManifest"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EngineManifest"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/EngineManifest"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reservations": {
      "post": {
        "tags": [
          "Reservations"
        ],
        "summary": "Reserve a coupon for checkout",
        "description": "Authoritative re-price and reserve a use. Returns 201 with the audited breakdown, or 409 with UsageLimitReached when the cap is consumed. Client-supplied totals are ignored.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReserveRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ReserveRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ReserveRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationCreatedResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationCreatedResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationCreatedResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationConflictResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationConflictResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationConflictResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reservations/{orderId}/confirm": {
      "post": {
        "tags": [
          "Reservations"
        ],
        "summary": "Confirm a reservation",
        "description": "Commits a reserved use after the order is persisted. Idempotent for the same orderId.",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
