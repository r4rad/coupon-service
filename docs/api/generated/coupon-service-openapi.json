  },
  "components": {
    "schemas": {
      "AdminPolicyResponse": {
        "required": [
          "policyId",
          "code",
          "trigger",
          "status",
          "eTag",
          "document"
        ],
        "type": "object",
        "properties": {
          "policyId": {
            "type": "string"
          },
          "code": {
            "type": [
              "null",
              "string"
            ]
          },
          "trigger": {
            "$ref": "#/components/schemas/PolicyTrigger"
          },
          "status": {
            "$ref": "#/components/schemas/PolicyStatus"
          },
          "eTag": {
            "type": "string"
          },
          "document": {
            "$ref": "#/components/schemas/JsonElement"
          }
        }
      },
      "CartLineRequest": {
        "required": [
          "lineId",
          "pizzaId",
          "category"
        ],
        "type": "object",
        "properties": {
          "lineId": {
            "type": "string"
          },
          "pizzaId": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "unitPrice": {
            "maximum": 79228162514264337593543950335,
            "minimum": 0.01,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "quantity": {
            "maximum": 2147483647,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "CartRequest": {
        "required": [
          "lines"
        ],
        "type": "object",
        "properties": {
          "lines": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartLineRequest"
            }
          }
        }
      },
      "CouponStatus": {
        "type": "integer"
      },
      "EngineLimits": {
        "required": [
          "maxParseNodes",
          "maxParseDepth"
        ],
        "type": "object",
        "properties": {
          "maxParseNodes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "maxParseDepth": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "EngineManifest": {
        "required": [
          "engineSchema",
          "facts",
          "conditionOperators",
          "effectOperators",
          "limits"
        ],
        "type": "object",
        "properties": {
          "engineSchema": {
            "type": "string"
          },
          "facts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ManifestFact"
            }
          },
          "conditionOperators": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "effectOperators": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limits": {
            "$ref": "#/components/schemas/EngineLimits"
          }
        }
      },
      "FactCost": {
        "type": "integer"
      },
      "JsonElement": { },
      "LinePricingResponse": {
        "required": [
          "lineId",
          "amount"
        ],
        "type": "object",
        "properties": {
          "lineId": {
            "type": "string"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "ManifestFact": {
        "required": [
          "path",
          "kind",
          "cost"
        ],
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ValueKind"
          },
          "cost": {
            "$ref": "#/components/schemas/FactCost"
          }
        }
      },
      "NearMissHintResponse": {
        "required": [
          "shortfall",
          "message"
        ],
        "type": "object",
        "properties": {
          "shortfall": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "PolicyStatus": {
        "type": "integer"
      },
      "PolicyTrigger": {
        "type": "integer"
      },
      "PreviewRequest": {
        "required": [
          "code",
          "customerId",
          "cart"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "customerId": {
            "type": "string"
          },
          "confirmedOrderCount": {
            "maximum": 2147483647,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "cart": {
            "$ref": "#/components/schemas/CartRequest"
          }
        }
      },
      "PreviewResponse": {
        "required": [
          "status",
          "reason",
          "hint",
          "pricing",
          "policyContentHash"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/CouponStatus"
          },
          "reason": {
            "oneOf": [
              {
