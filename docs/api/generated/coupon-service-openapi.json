    "/v1/coupons/preview": {
      "post": {
        "tags": [
          "Coupons"
        ],
        "summary": "Preview coupon pricing",
        "description": "Advisory evaluation against a basket. Returns 200 for applied and rejected outcomes with a full price breakdown. Never reserves or writes.",
