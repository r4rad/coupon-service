<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)\..\..\docs\api\generated</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name order-api-openapi</OpenApiGenerateDocumentsOptions>
    <SyncInsomniaOnBuild>true</SyncInsomniaOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <Import Project="$(MSBuildProjectDirectory)\..\..\build\sync-insomnia.targets"
          Condition="Exists('$(MSBuildProjectDirectory)\..\..\build\sync-insomnia.targets')" />

</Project>
