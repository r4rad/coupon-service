{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CouponService": {
    "Currency": "EUR",
    "LocalTimeZoneId": "UTC"
  },
  "Authentication": {
    "Jwt": {
      "Authority": "https://login.microsoftonline.com/{tenant-id}/v2.0",
      "Audience": "api://coupon-service",
      "Issuer": "https://login.microsoftonline.com/{tenant-id}/v2.0"
    },
    "TestToken": {
      "Enabled": false
    }
  }
}
